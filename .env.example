# MongoDB connection string, e.g. mongodb+srv://user:password@cluster.example.net/devcommunity
MONGODB_URI=
# Random secret that signs and encrypts session tokens (generate with: openssl rand -base64 32)
AUTH_SECRET=
# Public origin of the app, e.g. http://localhost:3000 (optional in development)
AUTH_URL=
# GitHub OAuth app credentials (callback: <AUTH_URL>/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth client credentials (callback: <AUTH_URL>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional comma-separated emails that are promoted to admin on sign-in
ADMIN_EMAILS=
